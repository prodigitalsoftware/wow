generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Drama {
  id            String   @id @default(cuid())
  title         String
  description   String
  genre         String
  tags          String   @default("[]") // JSON array of tag strings
  coverTheme    Int      @default(0) // index into cover gradient palette
  totalEpisodes Int      @default(0)
  status        String   @default("ongoing") // ongoing | completed
  views         Int      @default(0)
  likes         Int      @default(0)
  featured      Boolean  @default(false) // hero carousel
  trending      Boolean  @default(false)
  mustSee       Boolean  @default(false)
  hiddenGem     Boolean  @default(false)
  isNew         Boolean  @default(false)
  createdAt     DateTime @default(now())
  episodes      Episode[]
  favorites     Favorite[]
  progresses    WatchProgress[]
}

model Episode {
  id        String   @id @default(cuid())
  dramaId   String
  drama     Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  videoUrl  String
  duration  Int      @default(120) // seconds
  isFree    Boolean  @default(false)
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  progresses WatchProgress[]

  @@unique([dramaId, number])
}

model WatchProgress {
  id        String   @id @default(cuid())
  userId    String   @default("guest")
  dramaId   String
  drama     Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  position  Float    @default(0) // seconds into episode
  updatedAt DateTime @updatedAt

  @@unique([userId, dramaId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @default("guest")
  dramaId   String
  drama     Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, dramaId])
}
